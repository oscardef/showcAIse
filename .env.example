# Application Settings
APP_NAME=showcAIse
ENVIRONMENT=development
DEBUG=true

# API Keys - REQUIRED
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
TOGETHER_AI_API_KEY=your_together_ai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here  # Optional: for GPT-based recommendations

# Avatar Generation API (choose one)
DID_API_KEY=your_did_api_key_here  # D-ID for avatar generation
HEYGEN_API_KEY=your_heygen_api_key_here  # Alternative: HeyGen

# Database Configuration
POSTGRES_USER=showcaise_user
POSTGRES_PASSWORD=secure_password_change_me
POSTGRES_DB=showcaise
DATABASE_URL=postgresql://showcaise_user:secure_password_change_me@postgres:5432/showcaise

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# MinIO Configuration (S3-compatible storage)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret_change_me
MINIO_URL=http://minio:9000
MINIO_BUCKET=showcaise-videos

# JWT Authentication
JWT_SECRET=change_this_to_a_very_secure_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# API Gateway
API_GATEWAY_PORT=8000
RATE_LIMIT_PER_MINUTE=60

# Frontend
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000/ws

# Video Processing
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_DURATION_MINUTES=60
VIDEO_PROCESSING_TIMEOUT_SECONDS=1800
FRAME_SAMPLING_FPS=2  # Frames per second for CV analysis

# Speech Analysis
WHISPER_MODEL=base  # Options: tiny, base, small, medium, large
TRANSCRIPTION_LANGUAGE=en
FILLER_WORDS=um,uh,like,you know,so,actually,basically

# Computer Vision
CV_CONFIDENCE_THRESHOLD=0.7
EYE_CONTACT_THRESHOLD_DEGREES=15

# Avatar Generation
AVATAR_GENERATION_TIMEOUT_SECONDS=600
AVATAR_VOICE_STYLE=professional  # Options: professional, casual, enthusiastic

# Analytics
ANALYSIS_RETENTION_DAYS=90
ENABLE_RECOMMENDATIONS=true

# Celery Workers
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_WORKER_CONCURRENCY=4

# Monitoring (Optional)
GRAFANA_PASSWORD=admin_change_me
PROMETHEUS_RETENTION_DAYS=15

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# File Storage Lifecycle
DELETE_ORIGINAL_VIDEOS_AFTER_DAYS=30
DELETE_PROCESSED_FRAMES_AFTER_HOURS=24

# Rate Limiting & Quotas
USER_MONTHLY_UPLOAD_LIMIT_GB=10
USER_MONTHLY_ANALYSIS_LIMIT=50

# Logging
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json
